# ─── PostgreSQL ──────────────────────────
POSTGRES_DB=uip_db
POSTGRES_USER=uip_user
POSTGRES_PASSWORD=uip_password

# ─── Neo4j ───────────────────────────────
NEO4J_AUTH=neo4j/uip_neo4j_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=uip_neo4j_password

# ─── Backend ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://uip_user:uip_password@postgres:5432/uip_db
NEO4J_URI=bolt://neo4j:7687
JWT_SECRET=uip-secret-key-change-in-production
UPLOAD_DIR=/app/uploads

# ─── Ollama ──────────────────────────────
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3

# ─── Frontend ────────────────────────────
NEXT_PUBLIC_API_URL=http://backend:8000
